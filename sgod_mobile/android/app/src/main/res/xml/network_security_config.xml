<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain HTTP by default from API 28 onward. The backend is
  reached over http://one.depedmis.com, so cleartext is permitted for that
  host only — everything else stays HTTPS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">one.depedmis.com</domain>
    </domain-config>
</network-security-config>
